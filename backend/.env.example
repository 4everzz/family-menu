# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进入 Git）

# ==================== 应用 ====================
APP_NAME=小家智膳后端
# dev=开发环境 / prod=生产环境
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ==================== 数据库 ====================
# 格式：postgresql+psycopg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+psycopg://用户名:密码@127.0.0.1:5432/family_menu
DATABASE_ECHO=false

# ==================== 登录令牌 ====================
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机生成的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ==================== 微信小程序 ====================
WX_APPID=
# 获取路径：微信公众平台 → 开发 → 开发管理 → 开发设置 → AppSecret
WX_SECRET=

# ==================== 鉴权开关 ====================
# 开发模式：跳过微信校验，直接用固定 openid 登录（仅本地联调使用）
AUTH_DEV_MODE=false
AUTH_DEV_OPENID=dev_openid_0001

# ==================== 家庭组额度 ====================
# 一个人最多"创建"几个家庭组 / 最多"加入"几个（不含自己创建的）
# 改这两个数不用动代码。将来接会员时改 app/services/space_quota.py 那个函数即可。
MAX_OWNED_SPACES=2
MAX_JOINED_SPACES=2

# ==================== 拍照识别热量（DashScope Qwen-VL）====================
# ⚠️ 后端只读 backend/.env（core/config.py 里 BASE_DIR = backend/），别放到仓库根目录去。
# ⚠️ 系统环境变量优先级高于本文件：若系统里已有同名变量，会静默覆盖这里的值。
# 不填 Key 时识别接口会返回占位结果（mock=true），前端会提示"演示数据"——流程能跑，但认不出真实食物。
# Key 获取：阿里云百炼控制台 → API-KEY 管理。
DASHSCOPE_API_KEY=
# 国内站点用下面这个兼容模式端点；国际站点请换成 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可用的 VL 模型（2026-09 实测在售）：qwen-vl-max / qwen-vl-plus / qwen3-vl-plus / qwen3-vl-flash
VISION_MODEL=qwen-vl-max

# ==================== AI 对话（文本）====================
# 和上面的拍照识别分开配置：识图必须用 VL 模型，对话用文本模型即可（更便宜更快）。
# 拆开的另一个好处：将来换成本地模型（如 Ollama 跑 qwen）只改这两行，代码不动。
# ⚠️ CHAT_API_KEY / CHAT_BASE_URL **留空时会自动沿用上面的 DASHSCOPE_* 值**
#    （见 core/config.py 的 chat_api_key_effective / chat_base_url_effective），
#    所以只想用同一个 Key 的话，这三行可以不填——只改 CHAT_MODEL 换模型即可。
#    要接本地模型（如 Ollama）时才需要显式覆盖这两项。
CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可用的对话模型：qwen-plus / qwen-turbo / qwen-max / qwen3-max
CHAT_MODEL=qwen-plus
# 采样温度。**对话模型必须支持 OpenAI 风格的 function calling（tools 参数）**——
# AI 会拿它去调工具（查冰箱/查菜单/查热量），不支持就退化成纯聊天。
#   已知可用：qwen-plus（实测 finish_reason=tool_calls 正常）。
# 换模型的注意事项：
#   · 切 DeepSeek 时把 BASE_URL 改成 https://api.deepseek.com、
#     MODEL 改成 deepseek-flash（注意 `deepseek-chat` / `deepseek-reasoner`
#     这两个老模型名官方已不再列出，别照抄旧教程）。
#   · DeepSeek 默认走思考模式，更贵更慢，记账这种活建议显式关掉。
CHAT_TEMPERATURE=0.0

# ==================== AI 调用配额 ====================
# 每个用户每天最多能发起几次 AI 对话。
# 这是**成本保护**而不是安全边界：防止一个用户把 API 额度刷爆。
# 所以 Redis 不可用时会**放行**而不是拒绝（宁可多花钱，也不能让功能不可用）。
MAX_AI_CALLS_PER_DAY=50
AI_QUOTA_ENABLED=true

# ==================== Redis（缓存 + 计数）====================
# 用途：① 营养数据缓存（避免每次都起 MCP 子进程）
#       ② AI 调用次数计数（INCR 原子操作，天然防并发超限）
# ⚠️ 本机 Redis 是**原生安装**的（E:\Apps\Redis-8.4.6-...），跑在 6379，不是 Docker。
#    注意本机还有一个 Dify 的 redis 容器，但它没映射端口，不会冲突。
# Redis 不可用时服务照常启动：缓存静默失效、配额放行，不影响任何主流程。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# ==================== MCP（Model Context Protocol）====================
# 用途：接外部 MCP Server 拿权威数据，替代"完全依赖大模型估算"。
# 当前接的是 cn-food-mcp（《中国食物成分表》，数据内置、无需 API Key）。
#
# ⚠️ 默认 false —— 刻意如此，原因有三：
#    ① 首次调用要 `npx -y` 下载包（几十 MB），会明显拖慢第一次请求；
#    ② 它需要本机有 Node/npx，不是所有部署环境都有；
#    ③ 关掉时功能完全退化成纯 AI 估算，和接它之前**行为一致**——所以默认关是安全的。
# 想体验"查出来的"热量，把这里改成 true（需先确保本机 `npx --version` 能跑）。
MCP_ENABLED=false
# 单次 MCP 工具调用超时（秒）。npx 首次下载包可能需要 10 秒以上，所以给得比较宽。
# 起进程/握手阶段的超时是这个值的 2 倍（见 app/mcp/gateway.py 的说明）。
MCP_CALL_TIMEOUT=15

# ==================== MCP Server（对外暴露只读工具）====================
# 本项目**自己**也能当 MCP Server，把「查冰箱/查菜单」暴露给 Claude Desktop、Cursor 等客户端。
# 入口脚本：backend/run_mcp_server.py（不监听端口，走 stdio，由客户端当子进程拉起）
# 接入配置示例见 backend/README.md 的「MCP 集成」一节。
# 注意：它连的是同一个 DATABASE_URL，权限走同一套 JWT + 成员校验，
#      App 里看不到的数据，外部客户端同样看不到。
