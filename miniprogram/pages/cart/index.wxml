<view class="page-shell">
  <view wx:if="{{items.length}}" class="cart-list">
    <view wx:for="{{items}}" wx:key="cartKey" class="cart-card">
      <view class="cart-visual" style="background: {{item.color}};">{{item.emoji}}</view>
      <view class="cart-copy">
        <text class="cart-name">{{item.name}}</text>
        <text wx:if="{{item.optionsText}}" class="cart-options">{{item.optionsText}}</text>
        <text class="cart-price">¥{{item.price}}</text>
      </view>
      <view class="stepper">
        <button class="stepper-button" data-key="{{item.cartKey}}" bindtap="decrease" aria-label="减少{{item.name}}">−</button>
        <text class="stepper-value">{{item.quantity}}</text>
        <button class="stepper-button primary" data-key="{{item.cartKey}}" bindtap="increase" aria-label="增加{{item.name}}">+</button>
      </view>
    </view>
    <view class="remark-card">
      <text class="remark-label">订单备注</text>
      <textarea class="remark-input" value="{{remark}}" maxlength="80" placeholder="例如：少辣、不要香菜" bindinput="updateRemark" />
    </view>
  </view>
  <view wx:else class="empty-state">
    <text class="empty-title">购物车还是空的</text>
    <text class="empty-copy">去菜单里挑几道喜欢的菜吧</text>
  </view>

  <view wx:if="{{items.length}}" class="checkout-panel">
    <view class="checkout-summary"><text class="total-label">合计</text><text class="total-value">¥{{total}}</text></view>
    <view class="checkout-actions"><button class="clear-button" bindtap="clearCart" disabled="{{isSubmitting}}">清空</button><button class="checkout-button" bindtap="submitOrder" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">{{isSubmitting ? '正在提交' : '提交订单'}}</button></view>
  </view>
</view>
