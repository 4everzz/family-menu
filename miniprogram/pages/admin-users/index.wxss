.page-shell { min-height: 100vh; padding: 28rpx 24rpx 160rpx; box-sizing: border-box; background: #FEF2F2; }
.page-head { display: flex; flex-direction: column; gap: 8rpx; margin: 8rpx 4rpx 24rpx; }.page-title { color: #450A0A; font-size: 42rpx; font-weight: 700; }.page-note { color: #9F1239; font-size: 25rpx; }
.state-card { padding: 44rpx 24rpx; border: 2rpx solid #FECACA; border-radius: 18rpx; background: #FFFFFF; color: #64748B; text-align: center; font-size: 28rpx; }.user-list { display: flex; flex-direction: column; gap: 18rpx; }
.user-card { padding: 24rpx; border: 2rpx solid #FEE2E2; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(127, 29, 29, .05); }.user-main { display: flex; align-items: center; min-width: 0; gap: 16rpx; }
.avatar { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0; color: #B91C1C; background: #FEE2E2; font-size: 30rpx; font-weight: 700; }.user-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.user-name { overflow: hidden; color: #450A0A; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.user-identity { color: #78716C; font-size: 23rpx; }
.avatar-image { display: block; }
.role-tag { padding: 7rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 700; flex-shrink: 0; }.role-user { color: #9F1239; background: #FFF1F2; }.role-manager { color: #B45309; background: #FEF3C7; }.role-super_admin { color: #7C2D12; background: #FDE68A; }.user-meta { margin: 18rpx 0; color: #78716C; font-size: 24rpx; }
.actions { display: flex; gap: 14rpx; }.action-button { flex: 1; min-width: 0; height: 70rpx; margin: 0; padding: 0 12rpx; border-radius: 12rpx; font-size: 25rpx; font-weight: 700; line-height: 70rpx; box-sizing: border-box; }.secondary { color: #9F1239; background: #FFFFFF; border: 2rpx solid #FCA5A5; }.primary { color: #FFFFFF; background: #DC2626; }.danger { color: #B91C1C; background: #FEE2E2; }
