.page-shell { min-height: 100vh; padding: 28rpx 24rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF5F5; }
.content { display: flex; flex-direction: column; gap: 22rpx; }
.page-head, .section-card, .state-card { display: flex; flex-direction: column; gap: 14rpx; padding: 28rpx; border: 2rpx solid #FEE2E2; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 8rpx 22rpx rgba(69, 10, 10, .06); box-sizing: border-box; }
.page-title, .state-title { color: #450A0A; font-size: 40rpx; font-weight: 700; line-height: 1.25; }
.page-copy, .state-copy, .section-copy, .empty-copy { color: #64748B; font-size: 25rpx; line-height: 1.5; }
.page-note { padding: 14rpx 16rpx; border-radius: 12rpx; background: #FFF7ED; color: #C2410C; font-size: 24rpx; line-height: 1.5; }
.self-owner-button { width: 100% !important; min-width: 100% !important; min-height: 84rpx; margin: 0; padding: 0 20rpx !important; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 28rpx; font-weight: 700; line-height: 84rpx; white-space: nowrap; box-sizing: border-box; }
.self-owner-button::after { border: 0; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-title { color: #450A0A; font-size: 31rpx; font-weight: 700; line-height: 1.3; }
.section-count { color: #B91C1C; font-size: 24rpx; font-weight: 700; }
.member-list, .search-list { display: flex; flex-direction: column; gap: 14rpx; }
.member-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx; border: 2rpx solid #FFF1F1; border-radius: 18rpx; background: #FFFDFD; box-sizing: border-box; }
.search-row-card { display: flex; flex-direction: column; gap: 16rpx; padding: 20rpx; border: 2rpx solid #FFF1F1; border-radius: 18rpx; background: #FFFDFD; box-sizing: border-box; }
.member-main { min-width: 0; flex: 1; display: flex; align-items: center; gap: 16rpx; }
.search-main { width: 100%; flex: none; }
.member-avatar { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; border-radius: 50%; background: #FEE2E2; }
.member-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #B91C1C; font-size: 30rpx; font-weight: 800; }
.member-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.member-name { overflow: hidden; color: #450A0A; font-size: 29rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.member-meta { overflow: hidden; color: #78716C; font-size: 23rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.member-status { align-self: flex-start; padding: 4rpx 12rpx; border-radius: 999rpx; background: #FFF7ED; color: #C2410C; font-size: 22rpx; font-weight: 700; line-height: 1.35; }
.search-row { width: 100%; display: flex; align-items: center; gap: 10rpx; box-sizing: border-box; }
.search-input { width: 0; min-width: 0; flex: 1 1 auto; height: 80rpx; padding: 0 18rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; background: #FFFFFF; color: #450A0A; font-size: 27rpx; line-height: 76rpx; box-sizing: border-box; }
.clear-button { flex: 0 0 72rpx; width: 72rpx !important; min-width: 72rpx !important; max-width: 72rpx; height: 72rpx; margin: 0; padding: 0 !important; border-radius: 36rpx; background: #FEE2E2; color: #B91C1C; font-size: 36rpx; line-height: 68rpx; box-sizing: border-box; }
.search-button { flex: 0 0 132rpx; width: 132rpx !important; min-width: 132rpx !important; max-width: 132rpx; height: 80rpx; margin: 0; padding: 0 !important; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 27rpx; font-weight: 700; line-height: 80rpx; box-sizing: border-box; }
.clear-button::after, .search-button::after, .primary-button::after, .secondary-button::after, .danger-button::after { border: 0; }
.grant-actions { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.grant-actions.single { grid-template-columns: 1fr; }
.primary-button, .secondary-button, .danger-button { min-height: 72rpx; margin: 0; padding: 0 14rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 700; line-height: 72rpx; box-sizing: border-box; }
.primary-button, .secondary-button { width: 100% !important; min-width: 0; }
.primary-button { background: #DC2626; color: #FFFFFF; }
.secondary-button { border: 2rpx solid #FECACA; background: #FFFFFF; color: #B91C1C; line-height: 68rpx; }
.danger-button { width: 112rpx; min-width: 112rpx; border: 2rpx solid #FDA4AF; background: #FFF1F2; color: #BE123C; line-height: 68rpx; }
.primary-button[disabled], .secondary-button[disabled], .danger-button[disabled], .search-button[disabled] { opacity: .55; }
.access-card { margin-top: 160rpx; }
