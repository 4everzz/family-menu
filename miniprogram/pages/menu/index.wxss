px; height: 64rpx; margin: 0; padding: 0; border-radius: 32rpx; background: #DC2626; color: #FFFFFF; font-size: 34rpx; font-weight: 700; line-height: 60rpx; }.cart-drawer-stepper-button.secondary { background: #FEE2E2; color: #B91C1C; }.cart-drawer-quantity { min-width: 32rpx; color: #450A0A; font-size: 26rpx; font-weight: 700; text-align: center; }.cart-drawer-remark { padding: 14rpx 0; }.cart-drawer-remark-label { display: block; margin-bottom: 8rpx; color: #450A0A; font-size: 25rpx; font-weight: 700; }.cart-drawer-remark-input { width: 100%; height: 72rpx; padding: 12rpx 14rpx; border: 2rpx solid #FECACA; border-radius: 12rpx; background: #FFF9F9; color: #450A0A; font-size: 24rpx; line-height: 1.4; box-sizing: border-box; }.cart-drawer-footer { padding-top: 14rpx; border-top: 2rpx solid #FEE2E2; }.cart-drawer-total { display: flex; align-items: baseline; justify-content: space-between; color: #7C2D12; font-size: 25rpx; font-weight: 700; }.cart-drawer-total-value { color: #DC2626; font-size: 38rpx; }.cart-drawer-actions { display: flex; gap: 16rpx; margin-top: 14rpx; }.cart-drawer-clear, .cart-drawer-submit { height: 92rpx; margin: 0; padding: 0; border-radius: 14rpx; font-size: 29rpx; font-weight: 700; line-height: 92rpx; }.cart-drawer-clear { flex: .75; border: 2rpx solid #FCA5A5; background: #FFFFFF; color: #B91C1C; }.cart-drawer-submit { flex: 1.45; background: #DC2626; color: #FFFFFF; }.cart-drawer-clear[disabled], .cart-drawer-submit[disabled] { opacity: .55; }
