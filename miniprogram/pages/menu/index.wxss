.page-shell { padding: 24rpx 24rpx 132rpx; }
.welcome-card { min-height: 220rpx; padding: 32rpx; border-radius: 20rpx; background: #DC2626; color: #FFFFFF; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.welcome-copy { display: flex; flex-direction: column; gap: 10rpx; }
.eyebrow { font-size: 24rpx; opacity: .82; }
.page-title { font-size: 48rpx; font-weight: 700; }
.page-subtitle { font-size: 28rpx; opacity: .9; }
.bowl-mark { width: 104rpx; height: 104rpx; border-radius: 52rpx; background: #FFFFFF; color: #B91C1C; display: flex; align-items: center; justify-content: center; font-size: 46rpx; font-weight: 700; }
.category-scroll { margin-top: 24rpx; white-space: nowrap; }
.category-row { display: inline-flex; gap: 16rpx; padding-right: 24rpx; }
.category-button { min-width: 112rpx; height: 72rpx; padding: 0 24rpx; border-radius: 14rpx; background: #FFFFFF; color: #7C2D12; font-size: 28rpx; line-height: 72rpx; }
.category-button.active { background: #FEE2E2; color: #B91C1C; font-weight: 700; box-shadow: inset 0 0 0 2rpx #FCA5A5; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin: 32rpx 0 16rpx; }
.section-title { font-size: 36rpx; font-weight: 700; }
.section-note { color: #64748B; font-size: 26rpx; }
.dish-list { display: flex; flex-direction: column; gap: 16rpx; }
.dish-card { min-height: 172rpx; display: flex; align-items: center; gap: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #FFFFFF; box-sizing: border-box; box-shadow: 0 4rpx 16rpx rgba(69, 10, 10, .06); }
.dish-visual { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.dish-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.dish-name { font-size: 32rpx; font-weight: 700; }
.dish-description { overflow: hidden; color: #64748B; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.dish-price { margin-top: 4rpx; color: #DC2626; font-size: 30rpx; font-weight: 700; }
.dish-action { width: 88rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.add-button { width: 72rpx; height: 72rpx; padding: 0; border-radius: 36rpx; background: #DC2626; color: #FFFFFF; font-size: 44rpx; line-height: 68rpx; }
.quantity-label { color: #B91C1C; font-size: 22rpx; white-space: nowrap; }
.cart-bar { position: fixed; left: 24rpx; right: 24rpx; bottom: 116rpx; z-index: 2; height: 92rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 28rpx; background: #7C2D12; color: #FFFFFF; font-size: 30rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(69, 10, 10, .2); }
