<view class="page-shell">
  <view class="welcome-card">
    <view class="welcome-copy">
      <text class="eyebrow">家庭点餐</text>
      <text class="page-title">今天吃点什么？</text>
      <text class="page-subtitle">不登录也能直接点菜</text>
    </view>
    <view class="bowl-mark">食</view>
  </view>

  <view class="menu-layout">
    <view class="category-sidebar">
      <button
        wx:for="{{categories}}"
        wx:key="id"
        class="category-button {{activeCategory === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >{{item.name}}</button>
    </view>
    <view class="menu-content">
      <view class="section-head">
        <text class="section-title">今日菜单</text>
        <text class="section-note">{{dishes.length}} 道菜</text>
      </view>
      <view class="dish-list">
        <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openDish">
          <view class="dish-visual" style="background: {{item.color}};">
            <text>{{item.emoji}}</text>
          </view>
          <view class="dish-copy">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-description">{{item.description}}</text>
            <text class="dish-price">¥{{item.price}}</text>
          </view>
          <view class="dish-action">
            <button class="add-button" data-id="{{item.id}}" catchtap="addDish" aria-label="添加{{item.name}}">+</button>
            <text wx:if="{{item.quantity > 0}}" class="quantity-label">已选 {{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <button wx:if="{{cartCount > 0}}" class="cart-bar" bindtap="goCart">
    <view class="cart-bar-summary">
      <text class="cart-bar-count">已选 {{cartCount}} 道</text>
      <text class="cart-bar-total">¥{{cartTotal}}</text>
    </view>
    <view class="cart-bar-checkout">去结算</view>
  </button>

  <view wx:if="{{selectedDish}}" class="dish-modal-mask" bindtap="closeDish">
    <view class="dish-modal" catchtap="stopModalPropagation">
      <button class="modal-close" bindtap="closeDish" aria-label="关闭菜品详情">×</button>
      <view class="modal-dish-visual" style="background: {{selectedDish.color}};">
        <text>{{selectedDish.emoji}}</text>
      </view>
      <view class="modal-heading">
        <view>
          <text class="modal-dish-name">{{selectedDish.name}}</text>
          <text class="modal-dish-detail">{{selectedDish.detail}}</text>
        </view>
        <text class="modal-dish-price">¥{{selectedDish.price}}</text>
      </view>
      <view class="modal-option-section">
        <text class="modal-option-title">辣度</text>
        <view class="modal-choice-row">
          <button wx:for="{{['不辣', '微辣', '正常辣', '特辣']}}" wx:key="*this" data-value="{{item}}" bindtap="selectDetailSpicy" class="modal-choice {{selectedSpicy === item ? 'selected' : ''}}">{{item}}</button>
        </view>
      </view>
      <view class="modal-option-section modal-extra-section">
        <text class="modal-option-title">备注</text>
        <view class="modal-quick-row">
          <button wx:for="{{quickRemarkOptions}}" wx:key="label" data-value="{{item.label}}" bindtap="toggleQuickRemark" class="modal-quick-button {{item.selected ? 'selected' : ''}}">{{item.label}}</button>
        </view>
        <textarea class="modal-remark-input" value="{{customRemark}}" maxlength="40" placeholder="例如：不要香菜、打包" bindinput="updateCustomRemark" />
      </view>
      <button class="modal-add-button" bindtap="addSelectedDish">加入购物车</button>
    </view>
  </view>
</view>
