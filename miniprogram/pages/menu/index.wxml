<view class="page-shell">
  <view class="welcome-card">
    <view class="welcome-copy">
      <text class="eyebrow">{{shopName}}</text>
      <text class="page-title">今天吃点什么？</text>
      <text class="page-subtitle">当前桌号：{{tableName}}</text>
    </view>
    <button class="scan-mark" bindtap="scanTableCodeFromMenu" aria-label="扫码确认桌码">
      <view class="scan-icon" aria-hidden="true">
        <view class="scan-corner top-left"></view>
        <view class="scan-corner top-right"></view>
        <view class="scan-corner bottom-left"></view>
        <view class="scan-corner bottom-right"></view>
      </view>
      <text>扫码</text>
    </button>
  </view>

  <view class="menu-layout" style="height: {{menuHeight}}rpx;">
    <scroll-view class="category-sidebar" scroll-y>
      <button
        wx:for="{{categories}}"
        wx:key="id"
        class="category-button {{activeCategory === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >{{item.name}}</button>
    </scroll-view>
    <scroll-view class="menu-content" scroll-y scroll-top="{{menuScrollTop}}">
      <view class="menu-search">
        <text class="menu-search-label">搜索菜品</text>
        <view class="menu-search-control">
          <input class="menu-search-input" value="{{keyword}}" placeholder="输入菜品名称" confirm-type="search" bindinput="updateKeyword" />
          <button wx:if="{{keyword}}" class="menu-search-clear" bindtap="clearKeyword" aria-label="清空搜索内容">×</button>
        </view>
      </view>
      <view class="section-head">
        <text class="section-title">今日菜单</text>
        <text class="section-note">{{dishes.length}} 道菜</text>
      </view>
      <view wx:if="{{dishes.length}}" class="dish-list">
        <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openDish">
          <view class="dish-visual" style="background: {{item.color}};">
            <image wx:if="{{item.imageUrl}}" class="dish-photo" src="{{item.imageUrl}}" mode="aspectFill" />
            <text wx:else>{{item.emoji}}</text>
          </view>
          <view class="dish-copy">
            <text class="dish-name">{{item.name}}</text>
            <text class="dish-price">¥{{item.price}}</text>
          </view>
          <view class="dish-action">
            <text wx:if="{{item.isSoldOut}}" class="soldout-label">已售罄</text>
            <view wx:else class="dish-quick-add">
              <text wx:if="{{item.quantity}}" class="quantity-label">{{item.quantity}}</text>
              <button class="add-button" data-id="{{item.id}}" catchtap="addDish" aria-label="添加{{item.name}}">+</button>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="menu-empty-state"><text>{{menuError || '没有找到相关菜品'}}</text><text>{{menuError ? '请稍后重新进入点菜页' : '换个关键词试试'}}</text><button class="menu-shops-button" bindtap="goToMyShops">我的店铺</button></view>
      <view class="menu-bottom-spacer {{cartCount > 0 ? 'has-cart' : ''}}"></view>
    </scroll-view>
  </view>

  <view wx:if="{{cartCount > 0}}" class="cart-bar">
    <view class="cart-bar-main" bindtap="openCartDrawer" aria-label="打开购物车">
      <view class="cart-icon" aria-hidden="true"><view class="cart-icon-basket"></view><view class="cart-icon-wheel left"></view><view class="cart-icon-wheel right"></view><text class="cart-icon-badge">{{cartCount}}</text></view>
      <view class="cart-bar-summary"><text class="cart-bar-count">已选 {{cartCount}} 道</text><text class="cart-bar-total">¥{{cartTotal}}</text></view>
    </view>
    <button class="cart-bar-selected" bindtap="goCheckout">选好了</button>
  </view>

  <view wx:if="{{cartDrawerOpen}}" class="cart-drawer-mask" bindtap="closeCartDrawer">
    <view class="cart-drawer" catchtap="stopCartDrawerPropagation">
      <view class="cart-drawer-head"><view><text class="cart-drawer-title">已选菜品</text><text class="cart-drawer-note">已选 {{cartCount}} 道</text></view><button class="cart-drawer-clear-top" bindtap="clearCartWithConfirm">清空</button></view>
      <scroll-view class="cart-drawer-list" scroll-y>
        <view wx:for="{{cartItems}}" wx:key="cartKey" class="cart-drawer-item">
          <view class="cart-drawer-visual" style="background: {{item.color}};"><image wx:if="{{item.imageUrl}}" class="cart-drawer-photo" src="{{item.imageUrl}}" mode="aspectFill" /><text wx:else>{{item.emoji}}</text></view>
          <view class="cart-drawer-copy"><text class="cart-drawer-name">{{item.name}}</text><text wx:if="{{item.optionsText}}" class="cart-drawer-options">{{item.optionsText}}</text><text class="cart-drawer-price">¥{{item.price}}</text></view>
          <view class="cart-drawer-stepper"><button class="cart-drawer-stepper-button secondary" data-key="{{item.cartKey}}" bindtap="decreaseCartItem" aria-label="减少{{item.name}}">−</button><text class="cart-drawer-quantity">{{item.quantity}}</text><button class="cart-drawer-stepper-button" data-key="{{item.cartKey}}" bindtap="increaseCartItem" aria-label="增加{{item.name}}">+</button></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{selectedDish}}" class="dish-modal-mask" bindtap="closeDish">
    <view class="dish-modal" catchtap="stopModalPropagation">
      <button class="modal-close" bindtap="closeDish" aria-label="关闭菜品详情">×</button>
      <view class="modal-heading">
        <view>
          <text class="modal-dish-name">{{selectedDish.name}}</text>
          <text class="modal-dish-detail">{{selectedDish.description || selectedDish.detail}}</text>
        </view>
        <text class="modal-dish-price">¥{{selectedDish.price}}</text>
      </view>
      <view wx:if="{{selectedDish.spiceOptions.length}}" class="modal-option-section">
        <text class="modal-option-title">辣度</text>
        <view class="modal-choice-row">
          <button wx:for="{{selectedDish.spiceOptions}}" wx:key="*this" data-value="{{item}}" bindtap="selectDetailSpicy" class="modal-choice {{selectedSpicy === item ? 'selected' : ''}}">{{item}}</button>
        </view>
      </view>
      <view class="modal-option-section modal-extra-section">
        <text class="modal-option-title">备注</text>
        <textarea class="modal-remark-input" value="{{customRemark}}" maxlength="40" placeholder="例如：不要香菜、打包" bindinput="updateCustomRemark" />
      </view>
      <button class="modal-add-button" bindtap="addSelectedDish" disabled="{{selectedDish.isSoldOut}}">{{selectedDish.isSoldOut ? '该菜品已售罄' : '加入购物车'}}</button>
    </view>
  </view>
</view>
