.page-shell { min-height: 100vh; padding: 28rpx 24rpx 152rpx; box-sizing: border-box; background: #FEF2F2; }
.create-card { padding: 28rpx; border: 2rpx solid #FECACA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 10rpx 24rpx rgba(127, 29, 29, .06); }
.section-title { display: block; color: #450A0A; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.section-note { display: block; margin-top: 8rpx; color: #7F1D1D; font-size: 25rpx; line-height: 1.5; }
.field-label { display: block; margin-top: 24rpx; color: #7F1D1D; font-size: 26rpx; font-weight: 600; }
.text-input { width: 100%; height: 88rpx; margin-top: 10rpx; padding: 0 22rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; background: #FFFDFD; color: #450A0A; font-size: 30rpx; line-height: 84rpx; box-sizing: border-box; }
.entry-default { margin-top: 20rpx; padding: 18rpx 20rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; background: #FFF7F7; }
.entry-default-title { display: block; color: #7F1D1D; font-size: 27rpx; font-weight: 700; line-height: 1.35; }
.entry-default-note { display: block; margin-top: 6rpx; color: #9F1239; font-size: 23rpx; line-height: 1.5; }
.create-button { width: 100%; min-height: 92rpx; margin: 24rpx 0 0; padding: 0 24rpx; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 92rpx; box-sizing: border-box; }
.create-button::after { border: 0; }
.create-button[disabled] { background: #FDA4AF; }
.list-header { display: flex; align-items: center; justify-content: space-between; margin-top: 36rpx; padding: 0 4rpx; }
.list-count { color: #9F1239; font-size: 24rpx; }
.shop-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 18rpx; }
.shop-card { width: 100%; min-height: 108rpx; display: flex; align-items: center; justify-content: space-between; margin: 0; padding: 22rpx 24rpx; border: 2rpx solid #FECACA; border-radius: 18rpx; background: #FFFFFF; box-sizing: border-box; box-shadow: 0 8rpx 20rpx rgba(69, 10, 10, .05); text-align: left; }
.shop-card::after { border: 0; }
.shop-copy { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: 6rpx; }
.shop-name { overflow: hidden; color: #450A0A; font-size: 31rpx; font-weight: 700; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.shop-meta { color: #7F1D1D; font-size: 24rpx; line-height: 1.3; }
.shop-card-side { display: flex; flex-shrink: 0; flex-direction: column; align-items: flex-end; gap: 6rpx; margin-left: 20rpx; }
.shop-status { color: #15803D; font-size: 24rpx; font-weight: 700; }
.shop-status.is-disabled { color: #94A3B8; }
.manage-text { color: #B91C1C; font-size: 24rpx; font-weight: 700; }
.state-card { margin-top: 18rpx; padding: 48rpx 28rpx; border: 2rpx solid #FECACA; border-radius: 18rpx; background: #FFFFFF; color: #7F1D1D; font-size: 28rpx; text-align: center; box-shadow: 0 8rpx 20rpx rgba(69, 10, 10, .05); }
