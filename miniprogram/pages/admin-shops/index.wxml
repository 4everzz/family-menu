<view class="page-shell">
  <view class="create-card">
    <text class="section-title">创建店铺</text>
    <text class="section-note">新店初始为空，不会复制家庭店的菜品或订单</text>
    <text class="field-label">店铺名称</text>
    <input class="text-input" value="{{name}}" maxlength="20" placeholder="例如：幸福小馆" bindinput="updateName" />
    <view class="entry-default"><text class="entry-default-title">初始入口：店铺码进入</text><text class="entry-default-note">如需堂食桌码，请先在店铺设置中新增桌位后再切换。</text></view>
    <button class="create-button" loading="{{creating}}" disabled="{{creating}}" bindtap="createShop">创建并复制店铺码</button>
  </view>

  <view class="list-header"><text class="section-title">已有店铺</text><text class="list-count">{{shops.length}} 家</text></view>
  <view wx:if="{{loading}}" class="state-card"><text>正在读取店铺</text></view>
  <view wx:elif="{{shops.length}}" class="shop-list">
    <button wx:for="{{shops}}" wx:key="id" class="shop-card" data-shop="{{item}}" bindtap="openShopManagement">
      <view class="shop-copy"><text class="shop-name">{{item.name}}</text><text class="shop-meta">{{item.orderEntryMode === 'table_required' ? '堂食桌码入口' : '通用店铺入口'}}</text></view>
      <view class="shop-card-side"><text class="shop-status {{item.enabled ? '' : 'is-disabled'}}">{{item.enabled ? '正常' : '已停用'}}</text><text class="manage-text">管理</text></view>
    </button>
  </view>
  <view wx:else class="state-card"><text>暂未创建店铺</text></view>
</view>
