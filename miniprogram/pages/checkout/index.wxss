.page-shell { min-height: 100vh; padding: 32rpx 24rpx calc(220rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FEF2F2; }.page-head { display: flex; flex-direction: column; gap: 8rpx; margin: 8rpx 4rpx 24rpx; }.page-title { color: #450A0A; font-size: 42rpx; font-weight: 700; }.page-copy { color: #78716C; font-size: 25rpx; }.state-card, .order-card, .remark-card { border: 2rpx solid #FEE2E2; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(69, 10, 10, .05); box-sizing: border-box; }.state-card { margin-top: 120rpx; padding: 40rpx 24rpx; color: #78716C; font-size: 28rpx; text-align: center; }.order-card, .remark-card { padding: 24rpx; }.section-title { display: block; margin-bottom: 16rpx; color: #450A0A; font-size: 30rpx; font-weight: 700; }.order-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-top: 2rpx solid #FEF2F2; }.order-item:first-of-type { border-top: 0; }.order-visual { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 14rpx; font-size: 44rpx; }.order-photo { width: 100%; height: 100%; }.order-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 8rpx; }.order-name { overflow: hidden; color: #450A0A; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.order-options { overflow: hidden; color: #78716C; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.order-price { min-width: 88rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 7rpx; color: #DC2626; font-size: 29rpx; font-weight: 700; }.order-quantity { color: #78716C; font-size: 22rpx; font-weight: 400; }.remark-card { margin-top: 18rpx; }.remark-input { width: 100%; height: 88rpx; padding: 14rpx; border: 2rpx solid #FECACA; border-radius: 12rpx; background: #FFF9F9; color: #450A0A; font-size: 26rpx; line-height: 1.45; box-sizing: border-box; }.checkout-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #FEE2E2; background: #FFFFFF; box-sizing: border-box; }.continue-button, .confirm-button { height: 96rpx; margin: 0; padding: 0 20rpx; border-radius: 16rpx; font-size: 29rpx; font-weight: 700; line-height: 96rpx; }.continue-button { flex: .9; border: 2rpx solid #DC2626; background: #FFFFFF; color: #B91C1C; }.confirm-button { flex: 1.55; background: #DC2626; color: #FFFFFF; }.continue-button[disabled], .confirm-button[disabled] { opacity: .55; }
