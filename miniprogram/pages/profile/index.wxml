<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">
    <text>正在读取账户信息</text>
  </view>

  <view wx:elif="{{user}}">
    <view class="profile-card">
      <image wx:if="{{user.avatarUrl}}" class="avatar avatar-image" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">{{user.avatarText}}</view>
      <view class="profile-copy">
        <text class="profile-name">{{user.nickname}}</text>
        <text class="profile-note">{{user.roleText}}</text>
        <view wx:if="{{user.systemId}}" class="system-id-row" bindtap="copySystemId">
          <text class="system-id-label">系统ID</text>
          <text class="system-id-value">{{user.systemId}}</text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-row" hover-class="menu-row-active" bindtap="openProfileEdit">
        <view><text class="menu-title">资料设置</text></view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-row" hover-class="menu-row-active" bindtap="openHistory">
        <view><text class="menu-title">历史订单</text></view>
        <text class="menu-arrow">></text>
      </view>
      <view wx:if="{{isManager}}" class="menu-row" hover-class="menu-row-active" bindtap="openManager">
        <view><text class="menu-title">管理入口</text></view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view wx:else>
    <view class="profile-card guest-card">
      <view class="avatar">未</view>
      <view class="profile-copy">
        <text class="profile-name">需要登录</text>
        <text class="profile-note">登录后可结算、下单和查看订单</text>
      </view>
    </view>
    <button class="login-button" bindtap="openAuth">微信登录</button>
  </view>
</view>
