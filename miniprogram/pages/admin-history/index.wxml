<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card"><text class="state-title">正在读取历史订单</text><text class="state-copy">请稍候</text></view>
  <view wx:elif="{{hasAccess}}">
    <view class="page-head"><text class="page-title">历史订单</text><text class="order-count">{{orders.length}} 单</text></view>
    <view wx:if="{{orders.length}}" class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card" hover-class="order-card-active" data-id="{{item.id}}" bindtap="openOrder">
        <view class="order-head"><text class="order-id">订单 {{item.id}}</text><text class="order-arrow">></text></view>
        <text class="order-summary">{{item.summary}}</text>
        <view class="order-foot"><text>{{item.createdAt}}</text><text class="order-total">¥{{item.total}}</text></view>
      </view>
    </view>
    <view wx:else class="empty-state"><text class="empty-title">暂无历史订单</text><text class="empty-copy">完成的订单会保留在这里</text></view>
  </view>
  <view wx:else class="state-card access-card"><text class="state-title">暂无管理员权限</text><text class="state-copy">请返回“我的”确认管理员身份后再操作。</text></view>
</view>
