.page-shell { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF5F5; }
.page-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 8rpx 4rpx 24rpx; }.page-title, .state-title, .empty-title { color: #450A0A; font-size: 36rpx; font-weight: 700; line-height: 1.3; }.order-count { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 10rpx; background: #FEE2E2; color: #B91C1C; font-size: 24rpx; font-weight: 700; }
.order-list { display: flex; flex-direction: column; gap: 16rpx; }.order-card, .state-card { display: flex; flex-direction: column; gap: 14rpx; padding: 24rpx; border: 2rpx solid #FEE2E2; border-radius: 16rpx; background: #FFFFFF; box-shadow: 0 8rpx 22rpx rgba(69, 10, 10, .07); box-sizing: border-box; }.order-card-active { opacity: .78; }
.order-head, .order-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.order-id { min-width: 0; overflow: hidden; color: #450A0A; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.order-arrow { flex-shrink: 0; color: #B91C1C; font-size: 34rpx; line-height: 1; }.order-summary { overflow: hidden; color: #475569; font-size: 27rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.order-foot { color: #64748B; font-size: 24rpx; }.order-total { flex-shrink: 0; color: #DC2626; font-size: 32rpx; font-weight: 700; }
.state-card { margin-top: 120rpx; text-align: center; }.state-copy, .empty-copy { display: block; margin-top: 8rpx; color: #64748B; font-size: 25rpx; line-height: 1.5; }.empty-state { display: flex; flex-direction: column; align-items: center; gap: 4rpx; margin-top: 180rpx; text-align: center; }.empty-copy { margin-top: 0; }.access-card { margin-top: 160rpx; }
