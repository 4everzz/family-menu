.page-shell { min-height: 100vh; padding: 32rpx 24rpx calc(168rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF5F5; }
.stats-card, .state-card { display: flex; flex-direction: column; gap: 20rpx; padding: 30rpx 28rpx; border: 2rpx solid #FEE2E2; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 6rpx 18rpx rgba(69, 10, 10, .06); }
.page-head { display: flex; flex-direction: column; gap: 10rpx; }
.page-title, .state-title { color: #450A0A; font-size: 40rpx; font-weight: 700; line-height: 1.25; }
.page-copy, .state-copy { color: #64748B; font-size: 26rpx; line-height: 1.55; }

.range-tabs { display: flex; gap: 12rpx; padding: 6rpx; border-radius: 14rpx; background: #FFF1F1; }
.range-tab { flex: 1; min-width: 0; padding: 16rpx 0; border-radius: 10rpx; color: #7C2D12; font-size: 27rpx; font-weight: 600; text-align: center; line-height: 1.3; }
.range-tab-active { background: #DC2626; color: #FFFFFF; }

.summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.summary-item { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 14rpx; border-radius: 14rpx; background: #FFF5F5; text-align: center; }
.summary-value { color: #B91C1C; font-size: 36rpx; font-weight: 700; line-height: 1.1; }
.summary-label { color: #7C2D12; font-size: 22rpx; line-height: 1.3; }

.section { display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx; border-radius: 14rpx; background: #FFF7F7; }
.section-title { color: #450A0A; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.section-empty { color: #7F1D1D; font-size: 24rpx; line-height: 1.5; }

.daily-list { display: flex; flex-direction: column; gap: 10rpx; }
.daily-row { display: flex; align-items: center; gap: 12rpx; min-height: 44rpx; }
.daily-date { flex: none; width: 92rpx; color: #7C2D12; font-size: 23rpx; line-height: 1.3; }
.daily-bar-track { flex: 1; min-width: 0; height: 20rpx; border-radius: 10rpx; background: #FEE2E2; overflow: hidden; }
.daily-bar { height: 100%; border-radius: 10rpx; background: #DC2626; }
.daily-meta { flex: none; width: 176rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.daily-revenue { color: #B91C1C; font-size: 23rpx; font-weight: 700; line-height: 1.2; }
.daily-count { color: #9A3412; font-size: 20rpx; line-height: 1.2; }

.rank-list { display: flex; flex-direction: column; gap: 10rpx; }
.rank-row { display: flex; align-items: center; gap: 12rpx; min-height: 48rpx; }
.rank-index { flex: none; width: 40rpx; height: 40rpx; border-radius: 50%; font-size: 22rpx; font-weight: 700; text-align: center; line-height: 40rpx; }
.rank-index-top { background: #DC2626; color: #FFFFFF; }
.rank-index-normal { background: #FEE2E2; color: #7C2D12; }
.rank-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #450A0A; font-size: 26rpx; line-height: 1.4; }
.rank-quantity { flex: none; color: #B91C1C; font-size: 24rpx; font-weight: 700; }
.rank-revenue { flex: none; width: 128rpx; color: #9A3412; font-size: 23rpx; text-align: right; }

.state-card { gap: 16rpx; }
.access-card { margin-top: 120rpx; }
