<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在读取管理数据</text>
    <text class="state-copy">请稍候</text>
  </view>

  <view wx:elif="{{hasAccess}}" class="manage-card">
    <view class="page-head">
      <text class="page-title">管理中心</text>
      <text class="page-copy">当前管理：{{shopName}}</text>
    </view>
    <view class="stats-grid">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
    <view class="sales-section">
      <text class="sales-title">今日热销菜品</text>
      <view wx:if="{{topDishes.length}}" class="sales-list">
        <view wx:for="{{topDishes}}" wx:key="name" class="sales-item">
          <text class="sales-name">{{index + 1}}. {{item.name}}</text>
          <text class="sales-quantity">{{item.quantity}} 份</text>
        </view>
      </view>
      <text wx:else class="sales-empty">今日暂无已提交订单</text>
    </view>
    <view class="manage-actions">
      <button class="manage-button" bindtap="openDishesPage" loading="{{navigatingTarget === 'dishes'}}" disabled="{{!!navigatingTarget}}">管理菜品</button>
      <button class="manage-button" bindtap="openOrdersPage" loading="{{navigatingTarget === 'orders'}}" disabled="{{!!navigatingTarget}}">管理订单</button>
      <button class="manage-button" bindtap="openCategoriesPage" loading="{{navigatingTarget === 'categories'}}" disabled="{{!!navigatingTarget}}">管理分类</button>
      <button class="manage-button" bindtap="openShopSettings" loading="{{navigatingTarget === 'settings'}}" disabled="{{!!navigatingTarget}}">店铺设置</button>
    </view>
  </view>

  <view wx:else class="state-card access-card">
    <text class="state-title">暂未获得管理员权限</text>
    <text class="state-copy">请使用已被授权的微信账号登录后再操作。</text>
  </view>
</view>
