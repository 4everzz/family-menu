.page-shell { min-height: 100vh; padding: 32rpx 24rpx calc(168rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF5F5; }
.manage-card, .state-card { display: flex; flex-direction: column; gap: 20rpx; padding: 30rpx 28rpx; border: 2rpx solid #FEE2E2; border-radius: 18rpx; background: #FFFFFF; box-shadow: 0 6rpx 18rpx rgba(69, 10, 10, .06); }
.page-head { display: flex; flex-direction: column; gap: 10rpx; }
.page-title, .state-title { color: #450A0A; font-size: 40rpx; font-weight: 700; line-height: 1.25; }
.page-copy, .state-copy { color: #64748B; font-size: 26rpx; line-height: 1.55; }
.stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.stat-card { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 14rpx; border-radius: 14rpx; background: #FFF5F5; text-align: center; }
.stat-value { color: #B91C1C; font-size: 40rpx; font-weight: 700; line-height: 1; }
.stat-label { color: #7C2D12; font-size: 22rpx; line-height: 1.3; }
.sales-section { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx; border-radius: 14rpx; background: #FFF7F7; }
.sales-title { color: #450A0A; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.sales-list { display: flex; flex-direction: column; gap: 8rpx; }
.sales-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 48rpx; color: #7C2D12; font-size: 25rpx; line-height: 1.4; }
.sales-name { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sales-quantity { flex: none; color: #B91C1C; font-weight: 700; }
.sales-empty { color: #7F1D1D; font-size: 24rpx; line-height: 1.5; }
.manage-actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.manage-button { width: 100%; min-height: 92rpx; margin: 4rpx 0 0; padding: 0 24rpx; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 92rpx; box-sizing: border-box; }
.manage-actions .manage-button { width: calc((100% - 16rpx) / 2); min-width: 0; }
.manage-button[disabled] { opacity: .55; }
.state-card { gap: 16rpx; }
.access-card { margin-top: 120rpx; }
