<view class="page-shell">
  <view wx:if="{{loading}}" class="empty-state"><text class="empty-copy">正在读取订单</text></view>
  <view wx:elif="{{activeOrders.length || completedOrders.length}}" class="order-page">
    <view wx:if="{{activeOrders.length}}" class="order-section">
      <view class="section-head"><text class="section-title">制作中</text><text class="section-count">{{activeOrders.length}} 笔</text></view>
      <view class="order-list">
        <view wx:for="{{activeOrders}}" wx:key="id" class="order-card">
          <view class="order-head"><text class="order-id">订单 {{item.id}}</text><text class="order-status">{{item.status}}</text></view>
          <text class="order-items">{{item.summary}}</text>
          <text wx:if="{{item.remark}}" class="order-remark">备注：{{item.remark}}</text>
          <view class="progress-row">
            <view wx:for="{{item.progress}}" wx:for-item="step" wx:key="label" class="progress-step {{step.active ? 'active' : ''}}"><view class="progress-dot"></view><text>{{step.label}}</text></view>
          </view>
          <text class="order-note">{{item.statusNote}}</text>
          <view class="order-foot"><text>{{item.createdAt}}</text><text class="order-total">¥{{item.total}}</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{completedOrders.length}}" class="order-section completed-section">
      <view class="section-head"><text class="section-title">已完成</text><text class="section-count">最近 {{completedOrders.length}} 笔</text></view>
      <view class="order-list">
        <view wx:for="{{completedOrders}}" wx:key="id" class="order-card completed-order-card">
          <view class="order-head"><text class="order-id">订单 {{item.id}}</text><text class="order-status completed-status">{{item.status}}</text></view>
          <text class="order-items">{{item.summary}}</text>
          <text wx:if="{{item.remark}}" class="order-remark">备注：{{item.remark}}</text>
          <view class="progress-row">
            <view wx:for="{{item.progress}}" wx:for-item="step" wx:key="label" class="progress-step {{step.active ? 'active' : ''}}"><view class="progress-dot"></view><text>{{step.label}}</text></view>
          </view>
          <text class="order-note">{{item.statusNote}}</text>
          <view class="order-foot"><text>{{item.createdAt}}</text><text class="order-total">¥{{item.total}}</text></view>
        </view>
      </view>
      <text class="completed-hint">此处仅展示最近三次订单，更多请查看历史订单</text>
    </view>
  </view>
  <view wx:else class="empty-state"><text class="empty-title">暂无订单</text><text class="empty-copy">去菜单里选择几道喜欢的菜吧</text></view>
</view>
