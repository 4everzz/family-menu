.page-shell { padding: 24rpx 24rpx 168rpx; }
.order-list { display: flex; flex-direction: column; gap: 16rpx; }
.order-card { padding: 24rpx; border: 2rpx solid #FEE2E2; border-radius: 16rpx; background: #FFFFFF; display: flex; flex-direction: column; gap: 16rpx; box-shadow: 0 8rpx 22rpx rgba(69, 10, 10, .07); }
.order-head, .order-foot { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.order-id { font-size: 30rpx; font-weight: 700; }
.order-status { padding: 6rpx 14rpx; border-radius: 8rpx; background: #FEE2E2; color: #B91C1C; font-size: 24rpx; font-weight: 700; }
.order-items, .order-foot { color: #64748B; font-size: 26rpx; }
.order-remark, .order-note { color: #7C2D12; font-size: 26rpx; line-height: 1.55; }
.progress-row { display: flex; justify-content: space-between; gap: 8rpx; padding: 16rpx; border-radius: 12rpx; background: #FFF7F7; }
.progress-step { min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #94A3B8; font-size: 21rpx; text-align: center; }
.progress-dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; background: #CBD5E1; }
.progress-step.active { color: #B91C1C; font-weight: 700; }
.progress-step.active .progress-dot { background: #DC2626; }
.order-total { color: #DC2626; font-size: 34rpx; font-weight: 700; }
.order-complete-button { width: 100%; height: 84rpx; margin: 4rpx 0 0; padding: 0; border: 2rpx solid #DC2626; border-radius: 14rpx; background: #FFFFFF; color: #B91C1C; font-size: 29rpx; font-weight: 700; line-height: 80rpx; box-sizing: border-box; }
.order-complete-button[disabled] { border-color: #FCA5A5; background: #FFF1F1; color: #F87171; }
.empty-state { margin-top: 180rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #64748B; }
.empty-title { color: #450A0A; font-size: 36rpx; font-weight: 700; }
.empty-copy { font-size: 28rpx; }
