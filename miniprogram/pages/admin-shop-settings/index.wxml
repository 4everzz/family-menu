<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card"><text>正在读取店铺设置</text></view>
  <view wx:else>
    <view class="shop-name-card">
      <text class="section-title">店铺名称</text>
      <text class="setting-note">当前名称：{{shopName}}</text>
      <view wx:if="{{canRenameShop}}" class="shop-name-form">
        <block wx:if="{{nameChangeAvailable}}">
          <input class="shop-name-input" value="{{renameShopName}}" maxlength="20" placeholder="输入新店铺名称" bindinput="updateShopName" />
          <button class="shop-name-button" loading="{{renamingShop}}" disabled="{{renamingShop}}" bindtap="renameShop">修改名称</button>
        </block>
        <button wx:else class="shop-name-button cooldown" bindtap="showNameChangeCooldown">修改名称</button>
      </view>
    </view>

    <view class="entry-card">
      <text class="section-title">点餐入口方式</text>
      <text class="setting-note">选择顾客进入当前店铺并提交订单时需要扫描的码</text>
      <view class="entry-mode-grid">
        <button class="entry-mode-button {{orderEntryMode === 'store_entry' ? 'selected' : ''}}" data-mode="store_entry" loading="{{changingEntryMode && orderEntryMode !== 'store_entry'}}" disabled="{{changingEntryMode}}" bindtap="changeOrderEntryMode">
          <text class="entry-mode-title">店铺码进入</text><text class="entry-mode-note">扫描通用店铺码</text>
        </button>
        <button class="entry-mode-button {{orderEntryMode === 'table_required' ? 'selected' : ''}}" data-mode="table_required" loading="{{changingEntryMode && orderEntryMode !== 'table_required'}}" disabled="{{changingEntryMode}}" bindtap="changeOrderEntryMode">
          <text class="entry-mode-title">必须扫桌码</text><text class="entry-mode-note">仅堂食桌位可下单</text>
        </button>
      </view>
      <text wx:if="{{orderEntryMode === 'table_required'}}" class="entry-mode-tip">当前为桌码模式，请保持至少一张桌位处于可使用状态。</text>
    </view>

    <view class="settings-card">
      <text class="section-title">{{shopName}}</text>
      <view class="setting-row"><view><text class="setting-title">接收新订单</text><text class="setting-note">关闭后顾客仍可浏览菜单，但无法提交订单</text></view><switch checked="{{acceptingOrders}}" color="#DC2626" bindchange="toggleAcceptingOrders" /></view>
      <view class="date-section"><text class="setting-title">指定不营业日期</text><text class="setting-note">仅关闭选定的具体日期，不设置固定周休</text><view class="date-picker-row"><picker mode="date" value="{{selectedDate}}" start="{{selectedDate}}" bindchange="changeDate"><view class="date-value">{{selectedDate}}</view></picker><button class="date-add-button" bindtap="addClosedDate">添加</button></view></view>
      <view wx:if="{{closedDates.length}}" class="date-list"><view wx:for="{{closedDates}}" wx:key="*this" class="date-item"><text>{{item}}</text><button class="date-remove-button" data-date="{{item}}" bindtap="removeClosedDate">移除</button></view></view>
      <view wx:else class="empty-date"><text>暂未设置不营业日期</text></view>
      <button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveOperatingRules">保存营业设置</button>
    </view>

    <view class="security-card">
      <text class="section-title">店铺码</text>
      <text class="setting-note">重置后，原店铺码和二维码将立即失效</text>
      <view wx:if="{{currentShopCode}}" class="code-panel">
        <view class="code-copy" bindtap="copyLatestShopCode">
          <text class="code-label">当前店铺码</text>
          <text class="code-value">{{currentShopCode}}</text>
        </view>
        <view class="code-actions">
          <button class="code-action-button secondary" bindtap="copyLatestShopCode">复制数字码</button>
          <button class="code-action-button" bindtap="openShopQr">查看二维码</button>
        </view>
      </view>
      <view wx:else class="code-unavailable">
        <text>当前码不可查看，请重置后显示</text>
      </view>
      <button wx:if="{{currentShopCode}}" class="copy-qr-button" bindtap="copyLatestShopQrContent">复制二维码内容</button>
      <button class="rotate-button" loading="{{rotating}}" disabled="{{rotating}}" bindtap="rotateShopCode">{{rotateConfirming ? '再次点击确认重置' : '重置店铺码'}}</button>
    </view>

    <view class="table-card">
      <text class="section-title">堂食桌位</text>
      <text class="setting-note">固定桌位码可用于生成并张贴桌码二维码</text>
      <view class="table-add-row"><input class="table-name-input" value="{{tableName}}" maxlength="16" placeholder="例如：1号桌" bindinput="updateTableName" /><button class="table-add-button" loading="{{addingTable}}" disabled="{{addingTable}}" bindtap="addTable">新增</button></view>
      <view wx:if="{{latestTableCode}}" class="new-table-code-row"><view class="new-table-code" bindtap="copyLatestTableCode"><text>{{latestTableName}}新码：{{latestTableCode}}</text></view><button class="copy-code-button" bindtap="openTableQr">查看二维码</button></view>
      <view wx:if="{{tables.length}}" class="table-list">
        <view wx:for="{{tables}}" wx:key="id" class="table-item">
          <view class="table-copy">
            <text class="table-name">{{item.name}}</text>
            <text class="table-status {{item.enabled ? 'active' : 'disabled'}}">{{item.enabled ? '可使用' : '已停用'}}</text>
          </view>
          <view wx:if="{{item.displayCode}}" class="table-code-row" data-code="{{item.displayCode}}" bindtap="copyTableCode">
            <text class="table-code-label">当前桌码</text>
            <text class="table-code-value">{{item.displayCode}}</text>
          </view>
          <view wx:else class="table-code-missing"><text>当前码不可查看，请重置后显示</text></view>
          <view class="table-actions">
            <button class="table-action-button secondary" data-id="{{item.id}}" data-enabled="{{!item.enabled}}" loading="{{tableActionId === item.id}}" disabled="{{!!tableActionId}}" bindtap="toggleTableEnabled">{{item.enabled ? '停用' : '恢复'}}</button>
            <button wx:if="{{item.displayCode}}" class="table-action-button secondary" data-code="{{item.displayCode}}" data-name="{{item.name}}" disabled="{{!!tableActionId}}" bindtap="openExistingTableQr">二维码</button>
            <button class="table-action-button" data-id="{{item.id}}" data-name="{{item.name}}" disabled="{{!!tableActionId}}" bindtap="rotateTableCode">重置码</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-date"><text>暂未新增堂食桌位</text></view>
    </view>
    <view wx:if="{{showTableQr}}" class="qr-mask" bindtap="closeTableQr">
      <view class="qr-dialog" catchtap="stopQrTap">
        <text class="qr-title">{{qrTitle}}</text>
        <canvas class="table-qrcode" canvas-id="table-qrcode" style="width: {{qrCanvasSize}}px; height: {{qrCanvasSize}}px;"></canvas>
        <text class="qr-content">{{qrContent}}</text>
        <button class="qr-close-button" bindtap="closeTableQr">关闭</button>
      </view>
    </view>
  </view>
</view>
