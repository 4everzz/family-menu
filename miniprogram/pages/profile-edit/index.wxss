.page-shell { min-height: 100vh; padding: 48rpx 24rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FEF2F2; }
.page-head { display: flex; flex-direction: column; gap: 10rpx; margin: 8rpx 4rpx 32rpx; }.page-title { color: #450A0A; font-size: 44rpx; font-weight: 700; line-height: 1.25; }.page-copy { color: #78716C; font-size: 27rpx; line-height: 1.5; }
.state-card, .form-card { border: 2rpx solid #FEE2E2; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 8rpx 20rpx rgba(69, 10, 10, .06); box-sizing: border-box; }.state-card { padding: 44rpx 24rpx; color: #64748B; font-size: 28rpx; text-align: center; }.form-card { padding: 28rpx; }
.avatar-section { display: flex; align-items: center; gap: 20rpx; padding-bottom: 28rpx; border-bottom: 2rpx solid #FEE2E2; }.avatar-picker { width: 128rpx; height: 128rpx; min-width: 128rpx; margin: 0; padding: 0; border-radius: 64rpx; background: transparent; overflow: hidden; }.avatar-picker::after { border: 0; }.avatar-image, .avatar-fallback { width: 128rpx; height: 128rpx; border-radius: 64rpx; }.avatar-image { display: block; }.avatar-fallback { display: flex; align-items: center; justify-content: center; background: #FEE2E2; color: #B91C1C; font-size: 48rpx; font-weight: 700; }.avatar-copy { display: flex; flex-direction: column; gap: 8rpx; }.field-label { color: #450A0A; font-size: 30rpx; font-weight: 700; }.field-note { color: #78716C; font-size: 24rpx; }
.field-group { display: flex; flex-direction: column; gap: 14rpx; padding: 28rpx 0; }.nickname-input { width: 100%; min-height: 88rpx; padding: 0 20rpx; border: 2rpx solid #FCA5A5; border-radius: 14rpx; color: #450A0A; font-size: 30rpx; line-height: 84rpx; box-sizing: border-box; }.save-button { width: 100%; min-height: 92rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 92rpx; box-sizing: border-box; }.save-button[disabled], .avatar-picker[disabled] { opacity: .55; }
.reset-notice, .cooldown-notice { margin-bottom: 24rpx; padding: 18rpx 20rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; background: #FFF1F2; color: #B91C1C; font-size: 25rpx; line-height: 1.55; box-sizing: border-box; }
.cooldown-notice { border-color: #FED7AA; background: #FFF7ED; color: #9A3412; }
