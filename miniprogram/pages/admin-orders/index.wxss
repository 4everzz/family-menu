.page-shell { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFF5F5; }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 8rpx 4rpx 20rpx; }
.page-title, .state-title, .empty-title { color: #450A0A; font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.page-copy, .state-copy, .empty-copy { display: block; margin-top: 8rpx; color: #64748B; font-size: 25rpx; line-height: 1.5; }
.order-tabs { display: flex; gap: 14rpx; margin-bottom: 22rpx; }.tab-button { flex: 1; height: 80rpx; margin: 0; padding: 0 16rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; background: #FFFFFF; color: #7C2D12; font-size: 26rpx; font-weight: 700; line-height: 76rpx; box-sizing: border-box; }.tab-button.active { border-color: #DC2626; background: #FEE2E2; color: #B91C1C; }
.order-list { display: flex; flex-direction: column; gap: 16rpx; }
.order-card, .state-card { display: flex; flex-direction: column; gap: 16rpx; padding: 24rpx; border: 2rpx solid #FEE2E2; border-radius: 16rpx; background: #FFFFFF; box-shadow: 0 8rpx 22rpx rgba(69, 10, 10, .07); box-sizing: border-box; }
.order-head, .order-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.order-head-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.order-id { min-width: 0; overflow: hidden; color: #450A0A; font-size: 30rpx; font-weight: 700; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.order-location { align-self: flex-start; max-width: 100%; display: block; overflow: hidden; padding: 8rpx 16rpx; border-radius: 999rpx; background: #CCFBF1; color: #0F766E; font-size: 32rpx; font-weight: 800; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
.modal-location { display: block; overflow: hidden; color: #0F766E; font-size: 25rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.order-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 8rpx; background: #FEE2E2; color: #B91C1C; font-size: 24rpx; font-weight: 700; line-height: 1.3; }
.order-summary { color: #475569; font-size: 27rpx; line-height: 1.5; }
.order-remark { padding: 14rpx 16rpx; border-radius: 10rpx; background: #FFF7F7; color: #7C2D12; font-size: 25rpx; line-height: 1.5; }
.order-foot { color: #64748B; font-size: 24rpx; line-height: 1.4; }
.order-total { flex-shrink: 0; color: #DC2626; font-size: 34rpx; font-weight: 700; }
.order-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; }
.cancel-button, .complete-button { width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 16rpx; border-radius: 14rpx; font-size: 29rpx; font-weight: 700; line-height: 88rpx; box-sizing: border-box; }
.cancel-button::after, .complete-button::after, .modal-close::after, .cancel-modal-back::after, .cancel-modal-confirm::after, .tab-button::after { border: 0; }
.cancel-button { border: 2rpx solid #FECACA; background: #FFFFFF; color: #B91C1C; }
.complete-button { background: #DC2626; color: #FFFFFF; }
.cancel-button[disabled], .complete-button[disabled] { opacity: .55; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 4rpx; margin-top: 180rpx; text-align: center; }
.empty-copy { margin-top: 0; }
.state-card { margin-top: 120rpx; }
.access-card { margin-top: 160rpx; }
.history-card { min-height: 154rpx; }.order-card-active { opacity: .78; }.order-status.done, .modal-status.done, .order-status.cancelled, .modal-status.cancelled { background: #F1F5F9; color: #64748B; }
.history-modal-mask { position: fixed; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center; padding: 40rpx 28rpx; box-sizing: border-box; background: rgba(28, 25, 23, .48); }.history-modal { width: 100%; max-height: 88vh; display: flex; flex-direction: column; gap: 18rpx; padding: 24rpx; overflow-y: auto; border: 2rpx solid #FECACA; border-radius: 20rpx; background: #FFFFFF; box-sizing: border-box; box-shadow: 0 16rpx 40rpx rgba(28, 25, 23, .22); }.modal-close { width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0 0 0 auto; padding: 0; border-radius: 32rpx; background: #FEE2E2; color: #B91C1C; font-size: 40rpx; line-height: 58rpx; }.modal-head, .modal-dish, .modal-total { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.modal-id { display: block; color: #450A0A; font-size: 31rpx; font-weight: 700; }.modal-location { margin-top: 6rpx; }.modal-time { display: block; margin-top: 6rpx; color: #64748B; font-size: 23rpx; }.modal-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 8rpx; background: #FEE2E2; color: #B91C1C; font-size: 24rpx; font-weight: 700; }.modal-status.done { background: #F1F5F9; color: #64748B; }.modal-section { display: flex; flex-direction: column; gap: 14rpx; padding-top: 18rpx; border-top: 2rpx solid #FFF1F1; }.modal-title { color: #450A0A; font-size: 29rpx; font-weight: 700; }.modal-dish { padding-top: 12rpx; border-top: 2rpx solid #FFF7F7; }.modal-dish > view { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 8rpx; }.modal-dish-name { color: #450A0A; font-size: 27rpx; font-weight: 600; }.modal-dish-options { align-self: flex-start; max-width: 100%; overflow: hidden; padding: 6rpx 12rpx; border-radius: 999rpx; background: #FFF7ED; color: #C2410C; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }.modal-dish-price { flex: 0 0 auto; color: #B91C1C; font-size: 26rpx; font-weight: 700; }.modal-remark { color: #7C2D12; font-size: 26rpx; line-height: 1.55; }.modal-total { padding: 22rpx; border-radius: 16rpx; background: #DC2626; color: #FFFFFF; font-size: 30rpx; font-weight: 700; }.modal-total text:last-child { font-size: 40rpx; }
.cancel-note { padding: 16rpx; border-radius: 12rpx; background: #F8FAFC; }
.cancel-modal { width: 100%; max-width: 640rpx; display: flex; flex-direction: column; gap: 16rpx; padding: 32rpx; border-radius: 20rpx; background: #FFFFFF; box-sizing: border-box; }
.cancel-modal-title { color: #450A0A; font-size: 34rpx; font-weight: 700; }.cancel-modal-copy { color: #64748B; font-size: 26rpx; line-height: 1.55; }.cancel-reason-label { color: #450A0A; font-size: 27rpx; font-weight: 700; }
.cancel-reason-input { width: 100%; height: 88rpx; padding: 0 20rpx; border: 2rpx solid #FECACA; border-radius: 14rpx; color: #450A0A; font-size: 27rpx; box-sizing: border-box; }
.cancel-modal-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; margin-top: 8rpx; }.cancel-modal-back, .cancel-modal-confirm { width: 100%; min-width: 0; height: 88rpx; margin: 0; padding: 0 16rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 700; line-height: 88rpx; box-sizing: border-box; }.cancel-modal-back { border: 2rpx solid #FECACA; background: #FFFFFF; color: #B91C1C; }.cancel-modal-confirm { background: #DC2626; color: #FFFFFF; }.cancel-modal-back[disabled], .cancel-modal-confirm[disabled] { opacity: .55; }
