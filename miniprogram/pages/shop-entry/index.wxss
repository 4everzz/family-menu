.page-shell { min-height: 100vh; display: flex; align-items: center; padding: 28rpx 24rpx 152rpx; box-sizing: border-box; background: #FEF2F2; }
.entry-card { width: 100%; padding: 48rpx 32rpx; border: 2rpx solid #FECACA; border-radius: 20rpx; background: #FFFFFF; text-align: center; box-sizing: border-box; box-shadow: 0 12rpx 28rpx rgba(127, 29, 29, .08); }
.entry-title { display: block; color: #450A0A; font-size: 38rpx; font-weight: 700; line-height: 1.3; }
.entry-message { display: block; margin-top: 16rpx; color: #7F1D1D; font-size: 28rpx; line-height: 1.6; }
.loading-line { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 26rpx; color: #9F1239; font-size: 24rpx; }
.loading-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #DC2626; }
.back-button { width: 100%; min-height: 92rpx; margin: 32rpx 0 0; padding: 0 24rpx; border-radius: 14rpx; background: #DC2626; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 92rpx; box-sizing: border-box; }
.back-button::after { border: 0; }
