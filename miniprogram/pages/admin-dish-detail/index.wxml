<view class="page-shell">
  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在读取菜品</text>
    <text class="state-copy">请稍候</text>
  </view>

  <view wx:elif="{{hasAccess && mode === 'create'}}" class="create-form">
    <view class="form-head">
      <text class="page-title">新增菜品</text>
      <text class="page-copy">填写基础信息后即可加入用户点菜菜单</text>
    </view>
    <view class="form-row">
      <view class="form-field form-field-name">
        <text class="field-label">菜名</text>
        <input class="form-input" value="{{newDish.name}}" data-field="name" maxlength="20" placeholder="例如：青椒肉丝" bindinput="updateNewDish" />
      </view>
      <view class="form-field form-field-price">
        <text class="field-label">价格</text>
        <input class="form-input" type="digit" value="{{newDish.price}}" data-field="price" placeholder="0" bindinput="updateNewDish" />
      </view>
    </view>
    <view class="form-field">
      <text class="field-label">分类</text>
      <picker class="category-picker" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="selectNewDishCategory">
        <view class="picker-value">{{categories[categoryIndex].name || '请选择分类'}}</view>
      </picker>
    </view>
    <view class="form-field">
      <text class="field-label">辣度设置</text>
      <view class="spice-choice-grid"><button wx:for="{{newSpiceChoices}}" wx:key="label" class="spice-choice {{item.selected ? 'selected' : ''}}" data-mode="create" data-value="{{item.label}}" bindtap="toggleDishSpice">{{item.label}}</button></view>
      <view wx:if="{{newDish.spiceOptions.length}}" class="default-spice-section"><text class="default-spice-label">默认辣度</text><view class="default-spice-grid"><button wx:for="{{newDish.spiceOptions}}" wx:key="*this" class="default-spice-choice {{newDish.defaultSpice === item ? 'selected' : ''}}" data-mode="create" data-value="{{item}}" bindtap="selectDefaultSpice">{{item}}</button></view></view>
    </view>
    <view class="form-field">
      <text class="field-label">简介</text>
      <textarea class="description-input" value="{{newDish.description}}" data-field="description" maxlength="60" placeholder="例如：鲜香下饭，现炒更美味" bindinput="updateNewDish" />
    </view>
    <view class="form-field"><text class="field-label">菜品图片</text><view class="image-upload-row"><image wx:if="{{newDishImagePreviewUrl}}" class="dish-image-preview" src="{{newDishImagePreviewUrl}}" mode="aspectFill" /><view wx:else class="dish-image-placeholder">未添加图片</view><button class="image-button" data-mode="create" bindtap="chooseDishImage" loading="{{imageUploading}}" disabled="{{imageUploading}}">{{newDish.imageFileId ? '更换图片' : '添加图片'}}</button></view></view>
    <view class="form-actions">
      <button class="secondary-button" bindtap="cancelCreate" disabled="{{isSubmitting}}">取消</button>
      <button class="primary-button" bindtap="submitNewDish" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">新增菜品</button>
    </view>
  </view>

  <view wx:elif="{{hasAccess && dish}}">
    <view class="dish-summary">
      <text class="dish-name">{{dish.name}}</text>
      <text class="dish-category">{{categoryName}}</text>
      <text class="dish-status {{draftStatusClass}}">{{draftStatusText}}</text>
    </view>

    <view class="operation-card">
      <text class="operation-title">菜品资料</text>
      <view class="form-row">
        <view class="form-field form-field-name"><text class="field-label">菜名</text><input class="form-input" value="{{editDraft.name}}" data-field="name" maxlength="20" bindinput="updateEditDraft" /></view>
        <view class="form-field form-field-price"><text class="field-label">价格（元）</text><input class="form-input" type="digit" value="{{editDraft.price}}" data-field="price" bindinput="updateEditDraft" /></view>
      </view>
      <view class="form-field"><text class="field-label">分类</text><picker class="category-picker" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="selectEditCategory"><view class="picker-value">{{categories[categoryIndex].name || '请选择分类'}}</view></picker></view>
      <view class="form-field"><text class="field-label">辣度设置</text><view class="spice-choice-grid"><button wx:for="{{editSpiceChoices}}" wx:key="label" class="spice-choice {{item.selected ? 'selected' : ''}}" data-mode="edit" data-value="{{item.label}}" bindtap="toggleDishSpice">{{item.label}}</button></view><view wx:if="{{editDraft.spiceOptions.length}}" class="default-spice-section"><text class="default-spice-label">默认辣度</text><view class="default-spice-grid"><button wx:for="{{editDraft.spiceOptions}}" wx:key="*this" class="default-spice-choice {{editDraft.defaultSpice === item ? 'selected' : ''}}" data-mode="edit" data-value="{{item}}" bindtap="selectDefaultSpice">{{item}}</button></view></view></view>
      <view class="form-field"><text class="field-label">简介</text><textarea class="description-input" value="{{editDraft.description}}" data-field="description" maxlength="60" placeholder="用一句话介绍这道菜" bindinput="updateEditDraft" /></view>
      <view class="form-field"><text class="field-label">菜品图片</text><view class="image-upload-row"><image wx:if="{{editDishImagePreviewUrl}}" class="dish-image-preview" src="{{editDishImagePreviewUrl}}" mode="aspectFill" /><view wx:else class="dish-image-placeholder">未添加图片</view><button class="image-button" data-mode="edit" bindtap="chooseDishImage" loading="{{imageUploading}}" disabled="{{imageUploading}}">{{editDraft.imageFileId ? '更换图片' : '添加图片'}}</button></view></view>
      <view class="settings-divider"></view>
      <view class="form-field"><text class="field-label">商品状态</text><text class="operation-copy">状态操作确认后立即生效；下架后不显示，售罄后仍可查看但不能加购。</text><view class="status-actions"><button class="status-button {{editDraft.enabled === false ? 'restore-button' : ''}}" bindtap="toggleDishEnabled" loading="{{statusUpdating === 'enabled'}}" disabled="{{statusUpdating || savingDetails}}">{{editDraft.enabled === false ? '恢复上架' : '下架菜品'}}</button><button class="soldout-button {{editDraft.manualSoldOut ? 'restore-button' : ''}}" bindtap="toggleManualSoldOut" loading="{{statusUpdating === 'soldout'}}" disabled="{{statusUpdating || savingDetails}}">{{editDraft.manualSoldOut ? '恢复销售' : '设为售罄'}}</button></view></view>
      <view class="form-field"><text class="field-label">库存设置</text><text class="operation-copy">每天首次进入点菜页或下单时，剩余份数会恢复为每日份数；归零后自动售罄。</text><view class="form-row"><view class="form-field"><text class="field-label">每日份数</text><input class="form-input" type="number" value="{{editDraft.dailyStock}}" data-field="dailyStock" bindinput="updateEditDraft" /></view><view class="form-field"><text class="field-label">剩余份数</text><input class="form-input" type="number" value="{{editDraft.stock}}" data-field="stock" bindinput="updateEditDraft" /></view></view></view>
      <button class="primary-button save-dish-button" bindtap="saveDishDetails" loading="{{savingDetails}}" disabled="{{savingDetails || imageUploading || statusUpdating}}">保存菜品资料与库存</button>
    </view>

    <view class="delete-area"><text class="delete-title">删除菜品</text><text class="delete-copy">删除后不可恢复，已有历史订单仍会保留当时的菜品记录。</text><button class="delete-button" bindtap="deleteDish" loading="{{deleting}}" disabled="{{deleting}}">永久删除菜品</button></view>
  </view>

  <view wx:else class="state-card access-card"><text class="state-title">暂无管理员权限</text><text class="state-copy">请返回“我的”页面确认管理员身份。</text></view>
</view>
