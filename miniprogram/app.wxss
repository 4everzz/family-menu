page {
  min-height: 100vh;
  background: #FFF5F5;
  color: #450A0A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
}

button {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  border-radius: 16rpx;
}

button::after {
  border: 0;
}

button:active {
  opacity: .88;
}
